# Copy to .env and replace every change-me. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# --- core ---
APP_ENV=development
APP_URL=http://localhost:5173
# The college, where copy names it (SMS, PDFs, the landing page, the student card). The web build
# reads it too, so set it before building.
COLLEGE_NAME=Campus College
SECRET_KEY=change-me

# --- database / cache / storage ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portal
DATABASE_URL=postgresql+psycopg://portal:change-me@postgres:5432/portal
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=portal
S3_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET_DOCUMENTS=applicant-documents
S3_BUCKET_CONTENT=course-content

# --- OCR / Claude ---
OCR_LLM_MODE=fallback
OCR_MIN_CONFIDENCE=0.80
ANTHROPIC_API_KEY=
ASSISTANT_ENABLED=true
# Ask Campus (docs/04 §4.6). Without ANTHROPIC_API_KEY it says it isn't set up and offers Student Affairs.
ASSISTANT_MODEL=claude-haiku-4-5-20251001
ASSISTANT_MAX_TOKENS=1200
ASSISTANT_MAX_TOOL_ROUNDS=4
ASSISTANT_PER_HOUR=30
ASSISTANT_PER_DAY=200
# Not read yet: the retrieval index for Ask Campus isn't built (docs/04 §4.6).
EMBEDDING_MODEL=BAAI/bge-m3

# --- auth: portal as OIDC client of Authentik (served at /auth/ on the portal origin) ---
OIDC_ISSUER=http://localhost:5173/auth/application/o/tcfl-portal/
OIDC_INTERNAL_BASE_URL=http://authentik-server:9000
OIDC_CLIENT_ID=tcfl-portal
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
SESSION_MAX_AGE=1209600
SESSION_ENCRYPTION_KEY=change-me
# Admin API (password reset by SMS code, adding accepted applicants to portal-students). A token for
# an admin service account. Running the API on the host in dev: http://localhost:${AUTHENTIK_PORT}/auth/api/v3/
AUTHENTIK_API_URL=http://authentik-server:9000/auth/api/v3/
AUTHENTIK_API_TOKEN=change-me

# --- Authentik itself ---
AUTHENTIK_TAG=2026.8.3
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_PG_PASS=change-me
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=change-me
# Empty: Authentik sends no email, and sign-up keeps the applicant's email address unchecked.
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=Campus Portal <no-reply@example.ac.zw>
# Dev only: Authentik's port on the host (Vite proxies /auth to it).
AUTHENTIK_PORT=9000
# Authentik's SMS stage posts codes to the portal, which queues them (docs/10 §10.3). Same secret on both
# sides. The dev default reaches an API running on the host; in Compose use http://api:8000/internal/sms.
SMS_WEBHOOK_SECRET=change-me
PORTAL_SMS_WEBHOOK_URL=http://host.docker.internal:8000/internal/sms
# Check applicants' mobile numbers by SMS code at sign-up. Leave empty until SMS_PROVIDER is set up.
SIGNUP_VERIFY_PHONE=
# "Continue with Google" (docs/10 §10.3). Read by Authentik's blueprint and by the API. Google Cloud
# console → OAuth client (Web): redirect URI <portal origin>/auth/source/oauth/callback/google/
# (dev: http://localhost:5173/auth/source/oauth/callback/google/). Empty: no Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- notifications ---
# The portal's own email (password reset codes). Empty: nothing is sent; development logs it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Campus Portal <portal@example.ac.zw>
SMTP_USE_TLS=true
# Not read yet: texts queue in sms_outbox until an SMS worker and provider are added (docs/12).
SMS_PROVIDER=none
SMS_API_KEY=

# --- retention (days) --- not read yet: no retention job, and the periods aren't confirmed (docs/12)
RETENTION_REJECTED_APPLICATION_DOCS=180
RETENTION_CHAT_TRANSCRIPTS=90

# --- Applications (design/Payment, PayOffice, ReviewNotEligible) ---
# Unknowns in the designs: set them once the college confirms. Bank transfer is offered when
# BANK_NAME and BANK_ACCOUNT_NUMBER are set; mobile money needs a gateway (PAYMENT_PROVIDER).
# Empty PAYMENT_PROVIDER = none in production, the development simulator (no real money) elsewhere.
APPLICATION_FEE_USD=20.00
PAYMENT_PROVIDER=
# Empty: the same as COLLEGE_NAME.
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
ACCOUNTS_OFFICE=Block A, weekdays
ADMISSIONS_CONTACT=
DOCUMENT_RETENTION=
