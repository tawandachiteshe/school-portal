# Copy to .env and replace every change-me. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# --- core ---
APP_ENV=development
APP_URL=http://localhost:5173
SECRET_KEY=change-me

# --- database / cache / storage ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portal
DATABASE_URL=postgresql+psycopg://portal:change-me@postgres:5432/portal
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=portal
S3_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET_DOCUMENTS=applicant-documents
S3_BUCKET_CONTENT=course-content

# --- OCR / Claude ---
OCR_ENGINE=paddle
OCR_LLM_MODE=fallback
OCR_MIN_CONFIDENCE=0.80
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
ASSISTANT_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-m3

# --- auth: portal as OIDC client of Authentik (served at /auth/ on the portal origin) ---
OIDC_ISSUER=http://localhost:5173/auth/application/o/tcfl-portal/
OIDC_INTERNAL_BASE_URL=http://authentik-server:9000
OIDC_CLIENT_ID=tcfl-portal
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
SESSION_MAX_AGE=1209600
SESSION_ENCRYPTION_KEY=change-me
AUTHENTIK_API_URL=http://authentik-server:9000/auth/api/v3/
AUTHENTIK_API_TOKEN=change-me
IDP_WEBHOOK_SECRET=change-me

# --- Authentik itself ---
AUTHENTIK_TAG=2026.8.3
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_PG_PASS=change-me
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=change-me
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=TCFL Portal <no-reply@tcfl.ac.zw>

# --- notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TCFL Portal <portal@tcfl.ac.zw>
SMS_PROVIDER=none
SMS_API_KEY=

# --- retention (days) ---
RETENTION_REJECTED_APPLICATION_DOCS=180
RETENTION_CHAT_TRANSCRIPTS=90
