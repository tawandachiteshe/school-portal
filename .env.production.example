# Production environment for Dokploy (docs/06 §6.7). Paste into the Compose app's Environment tab.
# Easiest: `python3 infra/new-env.py https://portal.example.ac.zw > .env.production` fills every secret.
# Never commit the filled file.

# --- core ---
APP_ENV=production
APP_URL=https://portal.example.ac.zw
# The college, where copy names it (SMS, PDFs, the landing page, the student card). The web build
# reads it too, so set it before building.
COLLEGE_NAME=Campus College
# Traefik routes (docker-compose.prod.yml labels): the app's host, and a host for Authentik's admin console.
APP_HOST=portal.example.ac.zw
ID_HOST=id.portal.example.ac.zw
SECRET_KEY=change-me
WEB_CONCURRENCY=2
# First release is applications only: the landing page doesn't advertise the student portal (docs/12).
STUDENT_PORTAL_OPEN=false
# Pitch or training site only: allows the sample data on this server (make/app.seed). Seeding wipes everything.
DEMO=false

# --- database / cache / storage (all inside the Compose network) ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portal
DATABASE_URL=postgresql+psycopg://portal:change-me@tcfl-postgres:5432/portal
REDIS_URL=redis://tcfl-redis:6379/0
S3_ENDPOINT=http://tcfl-s3:8333
S3_ACCESS_KEY=portal
S3_SECRET_KEY=change-me
S3_BUCKET_DOCUMENTS=applicant-documents
S3_BUCKET_CONTENT=course-content

# --- Claude (OCR fallback and Ask Campus). Empty: OCR uses Tesseract only; Ask Campus says it isn't set up ---
ANTHROPIC_API_KEY=
OCR_LLM_MODE=fallback
ASSISTANT_ENABLED=true
# Haiku: fast and cheap. For harder questions try claude-sonnet-5.
ASSISTANT_MODEL=claude-haiku-4-5-20251001
OCR_CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- sign-in: the portal is an OIDC client of Authentik, served at /auth on the same domain ---
OIDC_ISSUER=https://portal.example.ac.zw/auth/application/o/tcfl-portal/
OIDC_INTERNAL_BASE_URL=http://tcfl-authentik:9000
OIDC_CLIENT_ID=tcfl-portal
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://portal.example.ac.zw/api/auth/callback
SESSION_ENCRYPTION_KEY=change-me
# A token for a service account in Authentik (Directory → Tokens), for password reset by code.
# Set it after the first deploy, then redeploy the api (docs/06 §6.7 step 9).
AUTHENTIK_API_URL=http://tcfl-authentik:9000/auth/api/v3/
AUTHENTIK_API_TOKEN=

# --- Authentik ---
AUTHENTIK_TAG=2026.8.3
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_PG_PASS=change-me
# First sign-in to Authentik's admin (user akadmin). Create named admins, then disable akadmin.
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
# Optional: an admin API token Authentik creates on its first start (new-env.py --demo sets it and
# uses it as AUTHENTIK_API_TOKEN). For real sites, prefer a service account's token.
AUTHENTIK_BOOTSTRAP_TOKEN=
# SMS codes: Authentik posts them to the portal on the internal network.
SMS_WEBHOOK_SECRET=change-me
PORTAL_SMS_WEBHOOK_URL=http://tcfl-api:8000/internal/sms
SIGNUP_VERIFY_PHONE=
# Email from Authentik (sign-up email check). Empty: no email is sent.
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=Campus Portal <no-reply@example.ac.zw>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email from the portal (password reset codes). Empty: nothing is emailed ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Campus Portal <portal@example.ac.zw>
SMTP_USE_TLS=true

# --- applications: set these once the college confirms them (docs/12 §12.1) ---
APPLICATION_FEE_USD=20.00
PAYMENT_PROVIDER=
# Empty: the same as COLLEGE_NAME.
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
ACCOUNTS_OFFICE=Block A, weekdays
ADMISSIONS_CONTACT=
DOCUMENT_RETENTION=
